# FinGuard AI Environment Configuration
# API Service
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=info

# Machine Learning Pipelines
FRAUD_MODEL_PATH=backend/models/fraud_model.joblib
CREDIT_MODEL_PATH=backend/models/credit_model.joblib
ANOMALY_MODEL_PATH=backend/models/anomaly_model.joblib
SENTIMENT_PIPELINE_PATH=backend/models/sentiment_pipeline.joblib

# Risk Policy Engine Defaults
DEFAULT_CRITICAL_THRESHOLD=80
DEFAULT_HIGH_THRESHOLD=55
DEFAULT_DTI_CEILING=0.45
DEFAULT_VELOCITY_CAP_24H=5

# Notification Webhooks (Institutional Secrets Not Hardcoded)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/KEY
SOC_EMAIL_ENDPOINT=alert-ops@finguard.ai
